{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Minifumo",
  "scopeName": "source.minifumo",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#wildcard"
    },
    {
      "include": "#types-and-constructors"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.minifumo",
          "match": "//.*$"
        },
        {
          "name": "comment.block.minifumo",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.declaration.data.minifumo",
          "match": "\\b(data)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.data.minifumo"
            },
            "2": {
              "name": "entity.name.type.minifumo"
            }
          }
        },
        {
          "name": "meta.declaration.function.minifumo",
          "match": "\\b(fun)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.minifumo"
            },
            "2": {
              "name": "entity.name.function.minifumo"
            }
          }
        },
        {
          "name": "meta.import.minifumo",
          "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.minifumo"
            },
            "2": {
              "name": "entity.name.namespace.minifumo"
            }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.minifumo",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.minifumo",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.integer.minifumo",
      "match": "\\b\\d+\\b"
    },
    "booleans": {
      "name": "constant.language.boolean.minifumo",
      "match": "\\b(true|false)\\b"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.minifumo",
          "match": "\\b(import|from|in|export|data|fun|match|case|if|then|else|let|forall|exists)\\b"
        },
        {
          "name": "keyword.operator.word.minifumo",
          "match": "\\b(and|or|not|AND|OR|NOT|div|mod)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.minifumo",
          "match": "<==>|==>|=>|->|<=|>=|==|!=|::|[+*\\-/%:=|<>.,]"
        },
        {
          "name": "punctuation.brackets.minifumo",
          "match": "[()\\[\\]{}]"
        }
      ]
    },
    "wildcard": {
      "name": "variable.language.wildcard.minifumo",
      "match": "\\b_\\b"
    },
    "types-and-constructors": {
      "name": "support.type.minifumo",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    }
  }
}
