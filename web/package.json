{
  "name": "minifumo-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile:compiler:dev": "cd .. && sbt compilerJs/fastLinkJS",
    "compile:compiler:prod": "cd .. && sbt compilerJs/fullLinkJS",
    "compile:compiler": "npm run compile:compiler:prod",
    "sync:compiler": "node ./scripts/sync-compiler.mjs",
    "predev": "npm run compile:compiler:dev && npm run sync:compiler",
    "prebuild": "npm run compile:compiler:prod && npm run sync:compiler",
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc -b && vite build && node ./scripts/export-static-routes.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.38.2",
    "codemirror": "^6.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "marked": "^14.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.11"
  }
}
