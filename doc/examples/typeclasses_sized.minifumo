data MyList[T: Type] = MyNil | MyCons(head: T, tail: MyList[T])

data MyTree[T: Type] = MyLeaf(value: T) | MyNode(left: MyTree[T], right: MyTree[T])

data MySized[T: Type] = MySizedMk(size: T -> Int)

fun listSize[T: Type](value: MyList[T]): Int
    match value
        case MyNil
            0
        case MyCons(_, tail)
            1 + listSize(tail)

fun treeSize[T: Type](value: MyTree[T]): Int
    match value
        case MyLeaf(_)
            1
        case MyNode(left, right)
            1 + treeSize(left) + treeSize(right)

fun sizedList[T: Type](): MySized[MyList[T]]
    MySizedMk[MyList[T]](listSize[T])

fun sizedTree[T: Type](): MySized[MyTree[T]]
    MySizedMk[MyTree[T]](treeSize[T])

fun totalSize[T: Type](list: MyList[T], tree: MyTree[T], s1: MySized[MyList[T]], s2: MySized[MyTree[T]]): Int
    match s1
        case MySizedMk(listSizeFn)
            match s2
                case MySizedMk(treeSizeFn)
                    listSizeFn(list) + treeSizeFn(tree)

fun main(): Unit
    let list: MyList[Int] = MyCons(1, MyCons(2, MyNil))
    let tree: MyTree[Int] = MyNode(MyLeaf(1), MyNode(MyLeaf(2), MyLeaf(3)))
    println(totalSize(list, tree, sizedList(), sizedTree()), showInt())

// Output:
// 7
