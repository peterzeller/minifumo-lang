fun addOne(l: List[Int]): List[Int]
    match l
        case Nil
            Nil
        case Cons(x, xs)
            Cons(x + 1, addOne(xs))

fun bindLater(): List[Int]
    let n = Nil
    let c = Cons
    c(1, c(2, n))


fun main(): Unit
    println(addOne(Cons(1, Cons(2, Cons(3, Nil)))), showList(showInt()))
    println(bindLater(), showList(showInt()))

// Output:
// Cons(2, Cons(3, Cons(4, Nil)))
// Cons(1, Cons(2, Nil))