data MyTree = MyLeaf(value: Int) | MyNode(left: MyTree, right: MyTree)

fun sum(tree: MyTree): Int
    match tree
        case MyLeaf(v)
            v
        case MyNode(l, r)
            sum(l) + sum(r)

fun main(): Unit
    let tree = MyNode(MyLeaf(1), MyNode(MyLeaf(2), MyLeaf(3))) in println(sum(tree), showInt())

// Output: 6
