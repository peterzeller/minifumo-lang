// Demonstrates that if-branches provide an equality fact named if_Eq.
fun if_branch_eq_fact(k: Bool): Bool
    if k
        let true_fact: Eq[Bool](k, True) = if_Eq
        True
    else
        let false_fact: Eq[Bool](k, False) = if_Eq
        False

// Demonstrates that match-branches provide an equality fact named match_Eq.
fun match_branch_eq_fact(k: Bool): Bool
    match k
        case True
            let true_fact: Eq[Bool](k, True) = match_Eq
            True
        case False
            let false_fact: Eq[Bool](k, False) = match_Eq
            False
