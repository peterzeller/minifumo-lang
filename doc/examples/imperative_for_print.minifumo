data MyList[A: Type] = MyNil | MyCons(head: A, tail: MyList[A])

fun logAll(numbers: MyList[Int]): Unit
    match numbers
        case MyNil
            MakeUnit
        case MyCons(head, tail)
            println(head, showInt())
            logAll(tail)

fun main(): Unit
    logAll(MyCons(1, MyCons(2, MyCons(3, MyNil))))

// Output:
// 1
// 2
// 3
