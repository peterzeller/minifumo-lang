data List[A: Type] = Nil | Cons(head: A, tail: List[A]())

fun logAll (numbers: List[Int]()): unit
    match numbers
        case Nil
            unit
        case Cons(head, tail)
            println(head, showInt())
            logAll(tail)

fun main (): unit
    logAll(Cons(1, Cons(2, Cons(3, Nil))))

// Output:
// 1
// 2
// 3
