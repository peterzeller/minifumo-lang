data MyList[A: Type] = MyNil | MyCons(head: A, tail: MyList[A])

fun logAll(numbers: MyList[Int]): Unit
    match numbers
        case MyNil
            MakeUnit
        case MyCons(head, tail)
            println[Int](head, showInt())
            logAll(tail)

fun main(): Unit
    logAll(MyCons[Int](1, MyCons[Int](2, MyCons[Int](3, MyNil[Int]))))

// Output:
// 1
// 2
// 3
