data List[A: Type] = Nil | Cons(head: A, tail: List[A])

fun logAll(numbers: List[Int]): Unit
    match numbers
        case Nil
            MakeUnit
        case Cons(head, tail)
            println[Int](head, showInt())
            logAll(tail)

fun main(): Unit
    logAll(Cons[Int](1, Cons[Int](2, Cons[Int](3, Nil[Int]))))

// Output:
// 1
// 2
// 3
