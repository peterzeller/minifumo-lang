// Computes the sum 0 + 1 + ... + n using Nat addition.
fun natSumTo(n: Nat): Nat
    match n
        case Zero
            Zero
        case Suc(k)
            natAdd(Suc(k), natSumTo(k))

// Computes the closed form n * (n + 1) / 2 directly with Nat arithmetic.
fun natGaussClosedForm(n: Nat): Nat
    natDiv(natMul(n, Suc(n)), Suc(Suc(Zero)))

// Computes the same closed form in a recursive shape that mirrors the induction step.
fun natGaussClosedFormRec(n: Nat): Nat
    match n
        case Zero
            let baseAsProductOverTwo = natDiv(natMul(Zero, Suc(Zero)), Suc(Suc(Zero)))
            Zero
        case Suc(k)
            let stepAsDiffOverTwo = natDiv(
                natSub(natMul(Suc(k), Suc(Suc(k))), natMul(k, Suc(k))),
                Suc(Suc(Zero))
            )
            natAdd(Suc(k), natGaussClosedFormRec(k))

// Proves by induction that natSumTo(n) equals n * (n + 1) / 2.
export fun nat_sum_equals_gauss(n: Nat): Eq[Nat, natSumTo(n), natGaussClosedFormRec(n)]
    match n
        case Zero
            refl
        case Suc(k)
            let ih: Eq[Nat, natSumTo(k), natGaussClosedFormRec(k)] = nat_sum_equals_gauss(k)
            congrArg[Nat, Nat, natSumTo(k), natGaussClosedFormRec(k)](
                (acc) => natAdd(Suc(k), acc),
                ih
            )
