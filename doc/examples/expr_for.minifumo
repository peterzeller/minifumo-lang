data MyList[A: Type] = MyNil | MyCons(head: A, tail: MyList[A])

fun printIncrement(values: MyList[Int]): Unit
    match values
        case MyNil
            MakeUnit
        case MyCons(head, tail)
            println(head + 1, showInt())
            printIncrement(tail)

fun main(): Unit
    let numbers: MyList[Int] = MyCons(1, MyCons(2, MyCons(3, MyNil)))
    printIncrement(numbers)

// Output:
// 2
// 3
// 4
