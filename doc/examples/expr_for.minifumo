data List[A: Type] = Nil | Cons(head: A, tail: List[A])

fun printIncrement(values: List[Int]): Unit
    match values
        case Nil
            MakeUnit
        case Cons(head, tail)
            println[Int](head + 1, showInt())
            printIncrement(tail)

fun main(): Unit
    let numbers: List[Int] = Cons[Int](1, Cons[Int](2, Cons[Int](3, Nil[Int])))
    printIncrement(numbers)

// Output:
// 2
// 3
// 4
