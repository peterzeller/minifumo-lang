data List[A: Type] = Nil | Cons(head: A, tail: List[A])

fun printIncrement(values: List[Int]): unit
    match values
        case Nil
            unit
        case Cons(head, tail)
            println(head + 1, showInt())
            printIncrement(tail)

fun main(): unit
    let numbers: List[Int] = Cons(1, Cons(2, Cons(3, Nil)))
    printIncrement(numbers)

// Output:
// 2
// 3
// 4
