data MyList[A: Type] = MyNil | MyCons(head: A, tail: MyList[A])

fun printIncrement(values: MyList[Int]): Unit
    match values
        case MyNil
            MakeUnit
        case MyCons(head, tail)
            println[Int](head + 1, showInt())
            printIncrement(tail)

fun main(): Unit
    let numbers: MyList[Int] = MyCons[Int](1, MyCons[Int](2, MyCons[Int](3, MyNil[Int])))
    printIncrement(numbers)

// Output:
// 2
// 3
// 4
