data MyOrd[T: Type] = MyOrdMk(lt: T -> T -> Bool)

fun ordIntFn(a: Int, b: Int): Bool
    a < b

fun ordInt(): MyOrd[Int]
    MyOrdMk(ordIntFn)

fun minOf2[T: Type](a: T, b: T, ord: MyOrd[T]): T
    match ord
        case MyOrdMk(ltFn)
            if ltFn(a, b) then a else b

fun minOf3[T: Type](a: T, b: T, c: T, ord: MyOrd[T]): T
    minOf2(minOf2(a, b, ord), c, ord)

fun main(): Unit
    println(minOf3(3, 1, 2, ordInt()), showInt())

// Output:
// 1
