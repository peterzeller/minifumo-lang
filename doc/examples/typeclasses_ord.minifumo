// Ord type class data with instances for Int and MyList.

data MyList[T] = Nil | Cons(head T, tail MyList[T])

data Ord[T] = Ord(lt T -> T -> Bool)

fun ordInt() Ord[Int]
    Ord((a Int, b Int) -> a < b)

// Compares two lists using the provided element ordering.
fun ordListCompare[T](a MyList[T], b MyList[T], ord Ord[T]) Bool
    match ord
        case Ord(ltFn)
            match a
                case Nil
                    match b
                        case Nil
                            false
                        case Cons(_, _)
                            true
                case Cons(ah, at)
                    match b
                        case Nil
                            false
                        case Cons(bh, bt)
                            if ltFn(ah, bh)
                                true
                            else
                                if ltFn(bh, ah)
                                    false
                                else
                                    ordListCompare(at, bt, ord)

// Builds an ordering for lists from an element ordering.
fun ordList[T](ord Ord[T]) Ord[MyList[T]]
    Ord((a MyList[T], b MyList[T]) -> ordListCompare(a, b, ord))

// Returns the smaller of two values using the given ordering.
fun minOf2[T](a T, b T, ord Ord[T]) T
    match ord
        case Ord(ltFn)
            if ltFn(a, b) then a else b

// Returns the smallest of three values using the given ordering.
fun minOf3[T](a T, b T, c T, ord Ord[T]) T
    minOf2(minOf2(a, b, ord), c, ord)

// Builds a Show dictionary for lists.
fun myShow[T](s Show[T]) Show[MyList[T]]
    Show((value MyList[T]) ->
        match value
            case Nil
                "Nil"
            case Cons(head, tail)
                stringAppend(
                    "Cons(",
                    stringAppend(show(head, s), stringAppend(", ", stringAppend(show(tail, myShow(s)), ")")))
                )
    )

fun main() unit
    println(minOf3(3, 1, 2, ordInt()), showInt())
    let list1 MyList[Int] = Cons(1, Cons(2, Nil))
    let list2 MyList[Int] = Cons(1, Cons(3, Nil))
    let list3 MyList[Int] = Cons(0, Cons(9, Nil))
    println(minOf3(list1, list2, list3, ordList(ordInt())), myShow(showInt()))

// Output:
// 1
// Cons(0, Cons(9, Nil))
