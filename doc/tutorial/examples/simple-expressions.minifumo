// Computes an Int result with let-bindings, if/then/else, and match.
fun classifyAndAdjust(flag: Bool, value: Int): Int
    let adjusted = if flag
        value + 1
    else
        value - 1

    let bump = match flag
        case True
            10
        case False
            20

    adjusted + bump

// Runs a small statement list in main.
fun main(): Unit
    let start = 5
    let result = classifyAndAdjust(True, start)
    println(result, showInt())
