// Applies a Nat -> Nat function n times to a base value.
fun repeatNat(f: Nat -> Nat, n: Nat, base: Nat): Nat
    match n
        case Zero
            base
        case Suc(k)
            f(repeatNat(f, k, base))

// Returns a curried increment function.
fun addCurried(x: Nat): Nat -> Nat
    (y: Nat) => natAdd(x, y)

// Adds two Nat values via repeated successor.
fun plus(a: Nat, b: Nat): Nat
    repeatNat((value: Nat) => Suc(value), a, b)

// Multiplies two Nat values via repeated addition.
fun mult(a: Nat, b: Nat): Nat
    repeatNat((value: Nat) => plus(value, b), a, Zero)

// Raises base to exponent via repeated multiplication.
fun pow(base: Nat, exponent: Nat): Nat
    repeatNat((value: Nat) => mult(value, base), exponent, Suc(Zero))

// Runs the functions example and prints a status line.
fun main(): Unit
    let _sum = plus(Suc(Suc(Zero)), Suc(Suc(Suc(Zero))))
    let _product = mult(Suc(Suc(Zero)), Suc(Suc(Suc(Zero))))
    let _power = pow(Suc(Suc(Zero)), Suc(Suc(Suc(Zero))))
    printlnString("repeatNat plus/mult/pow evaluated")
