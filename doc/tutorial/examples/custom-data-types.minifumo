// Defines a simple binary tree type for Int values.
data IntTree = IntEmpty | IntNode(value: Int, left: IntTree, right: IntTree)

// Computes the sum of all tree values.
fun treeSum(tree: IntTree): Int
    match tree
        case IntEmpty
            0
        case IntNode(value, left, right)
            value + treeSum(left) + treeSum(right)

// Runs the custom type example and prints the computed sum.
fun main(): Unit
    let tree = IntNode(10, IntNode(20, IntEmpty, IntEmpty), IntNode(30, IntEmpty, IntEmpty))
    println(treeSum(tree), showInt())
